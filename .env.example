# Copy this file to .env and fill in your actual values.
# Spring Boot loads .env automatically via spring.config.import.

# Database (Supabase / PostgreSQL)
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=your_supabase_user
DB_PASSWORD=your_supabase_password
DB_DRIVER=org.postgresql.Driver

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-characters
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
